# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bring-your-own-key (BYOK): there is NO global OpenAI key. Each signed-in user adds their own key in Settings -> OpenAI;
# it is validated against OpenAI, encrypted (AES-256-GCM) and stored server-side in the `user_api_keys` table.
# Server-only secrets (never use a NEXT_PUBLIC_ prefix). For Edge Functions: supabase secrets set KEY_ENCRYPTION_SECRET=... etc.
SUPABASE_SERVICE_ROLE_KEY=       # used only on the server to read/write user_api_keys and verify sessions
KEY_ENCRYPTION_SECRET=           # 32 random bytes, base64 or hex: generate with `openssl rand -base64 32`. Losing it makes stored keys unreadable.
# Local development ONLY: let requests without a user key fall back to a single server-side OPENAI_API_KEY. Keep false/unset in production.
# ALLOW_SERVER_OPENAI_KEY=false
# OPENAI_API_KEY=                # only read when ALLOW_SERVER_OPENAI_KEY=true
# Default models (each user can override them in Settings -> OpenAI -> Models)
# Responses API model for text/analysis (default: gpt-6.2-sol; gpt-6.2-astra for heavier reasoning)
OPENAI_TEXT_MODEL=gpt-6.2-sol
# Images API model (default: gpt-image-2.6-sunburst; gpt-image-2.6-flare is the fast variant)
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst

# Optional
# OPENAI_REASONING_MODEL=gpt-6.2-astra   # heavy reasoning / research tasks
# OPENAI_BASE_URL=                      # proxy or mock server (tests)

# Audio (all optional; defaults shown)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe      # speech-to-text (/v1/audio/transcriptions)
# OPENAI_TTS_MODEL=gpt-realtime-2.1-mini      # text-to-speech via the Realtime API
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1      # live voice (WebRTC)
# OPENAI_TTS_ENDPOINT=realtime                # or "speech" for the legacy /v1/audio/speech (shuts down 2027-01-06)
# OPENAI_SPEECH_MODEL=gpt-4o-mini-tts         # only used when OPENAI_TTS_ENDPOINT=speech

# Public pages (all optional)
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.org   # shown on the Privacy/Terms pages; when unset they point to /contact
# NEXT_PUBLIC_SOCIAL_TWITTER= / _LINKEDIN= / _GITHUB= / _FACEBOOK= / _INSTAGRAM=   # footer links are hidden when unset
# CONTACT_NOTIFY_WEBHOOK_URL=https://...      # https only; receives {kind, name, email, subject, message} JSON for each contact submission
# TRUST_PROXY_HEADERS=false                   # set true ONLY behind a proxy that overwrites X-Real-IP; otherwise the rate limiter ignores it
# PUBLIC_FORM_HOURLY_CAP=200                  # global per-hour ceiling of stored contact/newsletter rows (all clients)
# NETLIFY=true                                # set automatically on Netlify; enables trusting x-nf-client-connection-ip
