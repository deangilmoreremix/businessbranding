# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (SERVER-SIDE ONLY - never use a NEXT_PUBLIC_ prefix for this key)
# Also set as a Supabase secret for edge functions: supabase secrets set OPENAI_API_KEY=...
OPENAI_API_KEY=
# Responses API model for text/analysis (default: gpt-6.2-sol; gpt-6.2-astra for heavier reasoning)
OPENAI_TEXT_MODEL=gpt-6.2-sol
# Images API model (default: gpt-image-2.6-sunburst; gpt-image-2.6-flare is the fast variant)
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst

# Optional
# OPENAI_REASONING_MODEL=gpt-6.2-astra   # heavy reasoning / research tasks
# OPENAI_BASE_URL=                      # proxy or mock server (tests)

# Other providers (unchanged)
NEXT_PUBLIC_ELEVEN_LABS_API_KEY=
NEXT_PUBLIC_RECRAFT_API_KEY=
